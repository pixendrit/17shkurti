# 4-digit code used to unlock the dashboard
APP_PIN=1234

# Random string used to sign session cookies — CHANGE THIS.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL. adapter-node rejects form posts whose Origin doesn't match this,
# so behind a TLS-terminating proxy it MUST be the https:// address.
# Not needed on Vercel (it sets its own origin).
ORIGIN=https://hijeshi.dev.zhurma.fm

# Database.
#   Local file (dev, Docker, Fly — anywhere with a real disk):
DATABASE_URL=file:./data/hijeshi.db
#   Hosted libSQL (REQUIRED on Vercel/Netlify — serverless disks are ephemeral):
# DATABASE_URL=libsql://your-db-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# Traefik (only used by docker-compose.yml)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
APP_HOST=hijeshi.dev.zhurma.fm
